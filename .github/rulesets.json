[
  {
    "name": "Main: PR and passing CI required (no bypass)",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": { "ref_name": { "include": ["refs/heads/main"], "exclude": [] } },
    "rules": [
      { "type": "pull_request", "parameters": {
